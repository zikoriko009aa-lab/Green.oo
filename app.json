{
  "expo": {
    "name": "ULTRAS GREEN GHOST",
    "slug": "ultras-green-ghost",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06150c"
    },
    "android": {
      "package": "com.greenghost.ultras",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#075b2b"
      },
      "notification": {
        "icon": "./assets/notification-icon.png",
        "color": "#075b2b"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#075b2b",
          "defaultChannel": "general"
        }
      ]
    ]
  }
}
